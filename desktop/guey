#!/bin/sh
set -eu
umask 077
APP=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
STATE=${GUEY_DESKTOP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/guey-desktop}
case "$STATE" in /*) ;; *) echo 'GUEY_DESKTOP_STATE_DIR must be absolute' >&2; exit 1;; esac
command -v node >/dev/null || { echo 'Guey requires Node.js 22.19 or newer' >&2; exit 1; }
command -v flock >/dev/null || { echo 'Guey requires util-linux (flock)' >&2; exit 1; }
mkdir -p -- "$STATE"
export GUEY_DESKTOP_STATE_DIR="$STATE"
exec flock -w 40 "$STATE/launcher.lock" node "$APP/desktop/main.mjs" "$@"
